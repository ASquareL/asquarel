# ============================================================
# A Square L Innovate — Netlify Routing Rules
# Order matters: first match wins.
# ============================================================

# -- Root → public-site homepage -----------------------------
/                               /apps/public-site/index.html        200

# -- Academy app (must be BEFORE the public-site catch-all) --
/academy                        /apps/academy/index.html            200
/academy/                       /apps/academy/index.html            200
/academy/*                      /apps/academy/:splat                200

# -- ASLDS design system showcase ----------------------------
/aslds                          /packages/aslds/showcase/index.html 200
/aslds/                         /packages/aslds/showcase/index.html 200
/aslds/*                        /packages/aslds/showcase/:splat     200

# -- Public-site pages (all *.html at root level) ------------
/*.html                         /apps/public-site/:splat.html       200

